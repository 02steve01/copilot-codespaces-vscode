# College Library Management System

# Personalize the system with your Under 25 App username
USERNAME = "Abhay_U25"

# List to store books
library = []

# Function to add a book
def add_book():
    title = input("Enter book title: ").strip()
    author = input("Enter book author: ").strip()
    library.append({"title": title, "author": author})
    print(f'✅ "{title}" by {author} has been added to the library.')

# Function to search for a book
def search_book():
    search_title = input("Enter the book title to search: ").strip().lower()
    found_books = [book for book in library if search_title in book["title"].lower()]
    
    if found_books:
        print("\n🔍 Search Results:")
        for book in found_books:
            print(f'📖 {book["title"]} by {book["author"]}')
    else:
        print("❌ Book not found.")

# Function to display all books
def view_books():
    if not library:
        print("📚 The library is empty.")
        return
    print("\n📚 Books in Library:")
    for idx, book in enumerate(library, 1):
        print(f"{idx}. {book['title']} by {book['author']}")

# Main menu
def main():
    print(f"\n📚 Hello {USERNAME}, welcome to your Library!\n")
    
    while True:
        print("\nOptions:")
        print("1. Add a book")
        print("2. Search for a book")
        print("3. View all books")
        print("4. Exit")
        
        choice = input("Enter your choice (1-4): ").strip()
        
        if choice == "1":
            add_book()
        elif choice == "2":
            search_book()
        elif choice == "3":
            view_books()
        elif choice == "4":
            print("👋 Exiting... Have a great day!")
            break
        else:
            print("⚠️ Invalid choice. Please enter a number between 1 and 4.")

# Run the program
if _name_ == "_main_":
    main()
